{
    "continuous_inputs": [
        "xdev",
        "ydev"
    ],
    "continuous_outputs": [
        "angle",
        "power"
    ],
    "variable": {
        "tank": 50.0,
        "consumption": 0.1,
        "res_koef": 0.01,
        "angle": 0.0,
        "acceleration": 0.0,
        "mass": 0.0,
        "fuel": 0.0,
        "x": 0.0,
        "y": 0.0,
        "speed": 0.0,
        "resistance": 0.0,
        "xpath": 0.0,
        "xdev": 0.0,
        "ypath": 0.0,
        "ydev": 0.0
    },
    "formulas": [
        "angle = angle + circular",
        "acceleration = (power - resistance) / mass",
        "mass = weight - fuel",
        "fuel = tank - time * consumption",
        "x = speed * cos(angle)",
        "y = speed * sin(angle)",
        "speed = speed + acceleration",
        "resistance = res_koef * speed * speed",
        "xpath = time",
        "xdev = xpath - x",
        "ypath = time * time",
        "ydev = ypath - y"
    ]
}