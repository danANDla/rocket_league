{
    "all_sr_events": [
        "XDEV_ERROR",
        "YDEV_ERROR"
    ],
    "continuous_inputs": [
        "xdev",
        "ydev"
    ],
    "clock": "100",
    "sr_rules": [
        {
            "condition": "xdev > 3",
            "trigger": "XDEV_ERROR"
        },
        {
            "condition": "ydev > 3",
            "trigger": "YDEV_ERROR"
        }
    ],
    "de": {
        "variables": {
            "xproection": 0.1,
            "yproection": 0.1,
            "xrelative": 0.0,
            "yrelative": 0.0,
            "rotate_correction": 0.0
        },
        "events": [
            {
                "name": "XDEV_ERROR",
                "effects": [
                    {
                        "type": "add_external",
                        "target": "angle",
                        "delta": {
                            "type": "variable",
                            "name": "rotate_correction"
                        }
                    }
                ]
            },
            {
                "name": "YDEV_ERROR",
                "effects": [
                    {
                        "type": "add_external",
                        "target": "angle",
                        "delta": {
                            "type": "variable",
                            "name": "rotate_correction"
                        }
                    }
                ]
            },
            {
                "name": "x_proection",
                "effects": [
                    {
                        "type": "update_variable",
                        "variable": "xproection",
                        "delta": {
                            "type": "unary_op",
                            "op": "sin",
                            "arg": {
                                "type": "variable",
                                "name": "rotate"
                            }
                        }
                    }
                ]
            },
            {
                "name": "y_proection",
                "effects": [
                    {
                        "type": "update_variable",
                        "variable": "yproection",
                        "delta": {
                            "type": "unary_op",
                            "op": "cos",
                            "arg": {
                                "type": "variable",
                                "name": "rotate"
                            }
                        }
                    }
                ]
            },
            {
                "name": "x_relative",
                "effects": [
                    {
                        "type": "update_variable",
                        "variable": "xrelative",
                        "delta": {
                            "type": "binary_op",
                            "left": {
                                "type": "variable",
                                "name": "xdev"
                            },
                            "op": "/",
                            "right": {
                                "type": "variable",
                                "name": "xproection"
                            }
                        }
                    }
                ]
            },
            {
                "name": "y_relative",
                "effects": [
                    {
                        "type": "update_variable",
                        "variable": "yrelative",
                        "delta": {
                            "type": "binary_op",
                            "left": {
                                "type": "variable",
                                "name": "ydev"
                            },
                            "op": "/",
                            "right": {
                                "type": "variable",
                                "name": "yproection"
                            }
                        }
                    }
                ]
            },
            {
                "name": "r_correction",
                "effects": [
                    {
                        "type": "update_variable",
                        "variable": "rotate_correction",
                        "delta": {
                            "type": "binary_op",
                            "left": {
                                "type": "variable",
                                "name": "yrelative"
                            },
                            "op": "-",
                            "right": {
                                "type": "variable",
                                "name": "xrelative"
                            }
                        }
                    }
                ]
            },
            {
                "name": "power_changer",
                "trigger": {
                    "type": "expr_trigger",
                    "expr": {
                        "type": "variable",
                        "name": "abs(rotate_correction) < 0.1"
                    }
                },
                "effects": [
                    {
                        "type": "add_external",
                        "target": "power",
                        "delta": {
                            "type": "const",
                            "value": 1.0
                        }
                    }
                ]
            }
        ]
    }
}